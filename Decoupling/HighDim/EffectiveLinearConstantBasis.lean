import Decoupling.HighDim.EffectiveLinearConstant
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-!
# A finite constant-kernel generating family

The degree-zero kernel result is refined to the actual finite-dimensional
kernel of the coefficient matrix. Its ordinary field basis yields at most
`n` constant polynomial generators. No polynomial-kernel generating family
is an input. Choosing this field basis is not assigned an algorithmic cost;
a costed Gaussian basis can replace it in the effective solver separately.
-/

namespace Decoupling.HighDim.EffectiveLinear

open MvPolynomial Matrix
noncomputable section
variable {K : Type*} [Field K] {N m n : ℕ}

abbrev constantKernel (A : Matrix (Fin m) (Fin n) (MvPolynomial (Fin N) K)) :=
  LinearMap.ker (constantMatrix A).mulVecLin

abbrev constantKernelRank (A : Matrix (Fin m) (Fin n) (MvPolynomial (Fin N) K)) :=
  Module.finrank K (constantKernel A)

/-- The chosen basis belongs to the actual ordinary field kernel. -/
def constantKernelBasis (A : Matrix (Fin m) (Fin n) (MvPolynomial (Fin N) K)) :
    Module.Basis (Fin (constantKernelRank A)) K (constantKernel A) :=
  Module.finBasis K (constantKernel A)

def constantKernelGenerator (A : Matrix (Fin m) (Fin n) (MvPolynomial (Fin N) K))
    (i : Fin (constantKernelRank A)) : Fin n → MvPolynomial (Fin N) K :=
  constantVector (constantKernelBasis A i).val

/-- There are at most as many generators as original unknowns. -/
theorem constantKernelRank_le (A : Matrix (Fin m) (Fin n) (MvPolynomial (Fin N) K)) :
    constantKernelRank A ≤ n := by
  simpa using (constantKernel A).finrank_le

theorem constantKernelGenerator_mem
    (A : Matrix (Fin m) (Fin n) (MvPolynomial (Fin N) K))
    (hA : ∀ i j, (A i j).totalDegree ≤ 0) (i : Fin (constantKernelRank A)) :
    constantKernelGenerator A i ∈ degreeKernel A 0 := by
  constructor
  · rw [constantKernelGenerator, constantVector_mulVec A hA]
    have h := (constantKernelBasis A i).property
    change constantMatrix A *ᵥ (constantKernelBasis A i).val = 0 at h
    rw [h]
    funext j
    simp [constantVector]
  · intro j
    simp [constantKernelGenerator, constantVector]

/-- Every coefficient-field kernel vector has the actual finite basis expansion
also after inclusion into the polynomial modules. -/
theorem constantKernel_expansion
    (A : Matrix (Fin m) (Fin n) (MvPolynomial (Fin N) K)) (x : constantKernel A) :
    constantVector x.val = ∑ i, (C ((constantKernelBasis A).repr x i) : MvPolynomial (Fin N) K) • constantKernelGenerator A i := by
  classical
  funext j
  have h := congrArg (fun z : constantKernel A => (z : Fin n → K) j)
    ((constantKernelBasis A).sum_repr x)
  simp only [Submodule.coe_sum, Finset.sum_apply, Submodule.coe_smul, Pi.smul_apply, smul_eq_mul] at h
  change C (x.val j) = _
  rw [← h, map_sum]
  simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, constantKernelGenerator,
    constantVector, map_mul]

/-- The actual polynomial kernel is generated by this finite family of
constant vectors; its number is bounded by the original column count. -/
theorem constant_kernel_eq_span_basis
    (A : Matrix (Fin m) (Fin n) (MvPolynomial (Fin N) K))
    (hA : ∀ i j, (A i j).totalDegree ≤ 0) :
    LinearMap.ker A.mulVecLin =
      Submodule.span (MvPolynomial (Fin N) K) (Set.range (constantKernelGenerator A)) := by
  rw [constant_kernel_eq_span A hA]
  apply le_antisymm
  · apply Submodule.span_le.mpr
    intro y hy
    have hx : coefficientVector 0 y ∈ constantKernel A := by
      change constantMatrix A *ᵥ coefficientVector 0 y = 0
      rw [← coefficient_mulVec_constant A hA, hy.1]
      funext i
      simp [coefficientVector]
    let x : constantKernel A := ⟨coefficientVector 0 y, hx⟩
    have hxy : y = constantVector x.val := by
      funext j
      exact totalDegree_eq_zero_iff_eq_C.mp (Nat.eq_zero_of_le_zero (hy.2 j))
    rw [hxy, constantKernel_expansion]
    apply Submodule.sum_mem
    intro i _
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i,rfl⟩)
  · apply Submodule.span_le.mpr
    rintro _ ⟨i,rfl⟩
    exact Submodule.subset_span (constantKernelGenerator_mem A hA i)

/-- A finite family and its degree/rank/generation properties, all constructed
from the actual constant matrix rather than provided as certificates. -/
theorem exists_constant_kernel_generators
    (A : Matrix (Fin m) (Fin n) (MvPolynomial (Fin N) K))
    (hA : ∀ i j, (A i j).totalDegree ≤ 0) :
    ∃ r ≤ n, ∃ g : Fin r → (Fin n → MvPolynomial (Fin N) K),
      (∀ i, g i ∈ degreeKernel A 0) ∧
      LinearMap.ker A.mulVecLin = Submodule.span (MvPolynomial (Fin N) K) (Set.range g) :=
  ⟨constantKernelRank A, constantKernelRank_le A, constantKernelGenerator A,
    constantKernelGenerator_mem A hA, constant_kernel_eq_span_basis A hA⟩

end
end Decoupling.HighDim.EffectiveLinear
