import Decoupling.HighDim.HermannHomogeneous
import Decoupling.HighDim.HermannInhomogeneousField
import Decoupling.HighDim.EffectiveLinearKernelDescent

/-!
# Effective polynomial linear algebra over every field

The homogeneous theorem is the actual native kernel-spanning assertion, with
Hermann's cited degree bound. The inhomogeneous theorem is imported with a
conservative factor-4 bound. Both are proved for arbitrary finite-variable
polynomial rings over arbitrary fields; no solver, normalization, basis or
external theorem certificate is supplied by the caller.
-/

namespace Decoupling.HighDim.Hermann
open Matrix MvPolynomial
noncomputable section
variable {K : Type*} [Field K] {N m n d : ℕ}

/-- Every actual polynomial kernel is generated by its degree-bounded elements.
The finite-field case follows by the proved, degree-preserving span descent. -/
theorem kernel_generation (A : Matrix (Fin m) (Fin n) (MvPolynomial (Fin N) K))
    (hA : ∀ i j, (A i j).totalDegree ≤ d) :
    LinearMap.ker A.mulVecLin = Submodule.span (MvPolynomial (Fin N) K)
      (EffectiveLinear.degreeKernel A (hermannBound N m d)) := by
  let L := RatFunc K
  let : Infinite L := Infinite.of_injective (algebraMap (Polynomial K) L)
    (IsFractionRing.injective _ _)
  let f := MvPolynomial.map (algebraMap K L) (σ := Fin N)
  have hgen := kernel_generation_infinite N m n d (A.map f)
    (fun i j => (map_totalDegree_le _ (A i j)).trans (hA i j))
  exact EffectiveLinear.descend_kernel_generation A (hermannBound N m d) hgen

/-- The common factor-4 cutoff suffices for homogeneous and inhomogeneous tasks. -/
theorem kernel_generation_common (A : Matrix (Fin m) (Fin n) (MvPolynomial (Fin N) K))
    (hA : ∀ i j, (A i j).totalDegree ≤ d) :
    LinearMap.ker A.mulVecLin = Submodule.span (MvPolynomial (Fin N) K)
      (EffectiveLinear.degreeKernel A ((4 * m * d) ^ (2 ^ N))) := by
  apply kernel_generation_mono A _ (kernel_generation A hA)
  exact Nat.pow_le_pow_left (by nlinarith : 2 * m * d ≤ 4 * m * d) _

end
end Decoupling.HighDim.Hermann
