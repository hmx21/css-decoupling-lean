import Decoupling.HighDim.HermannTransportMonic
import Decoupling.HighDim.HermannHomogeneousStep

/-!
# The complete infinite-field homogeneous Hermann induction

The actual kernel is generated by solutions of the stated uniform degree.
The proof chooses a genuine maximal minor, constructs monic coordinates,
reduces to an actual coefficient matrix with one fewer variable, invokes
the induction hypothesis, and transports its generated span back. There
is no bounded-generation or normalization certificate in the theorem's inputs.
-/

namespace Decoupling.HighDim.Hermann

open Matrix MvPolynomial EffectiveLinear
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
variable {K : Type*} [Field K] [Infinite K]

/-- The degree recurrence is proved for every matrix, including empty rows,
empty columns, zero variables, degree zero, and rank zero. -/
theorem kernel_generation_recurrence (N m n d : ℕ)
    (A : Matrix (Fin m) (Fin n) (MvPolynomial (Fin N) K))
    (hA : ∀ i j, (A i j).totalDegree ≤ d) :
    LinearMap.ker A.mulVecLin =
      Submodule.span (MvPolynomial (Fin N) K) (degreeKernel A (recurrenceBound N m d)) := by
  induction N generalizing m n d with
  | zero => exact noVariables_kernel_eq_span A
  | succ N ih =>
    obtain ⟨r,rows,hr,hker,⟨M⟩⟩ := exists_monicMinorData A d hA
    let A₀ := A.submatrix rows id
    let A' := transformedMatrix M.e A₀
    let C := lastCoefficientMatrix A' d (r*d)
    let B := recurrenceBound N (Fintype.card (Fin r × Fin (d+r*d))) d
    have hA' : ∀ i j, (A' i j).natDegree ≤ d := fun i j =>
      (natDegree_le_flatten_totalDegree _).trans (M.matrixDegree i j)
    have hC : ∀ i j, (finiteMatrix C i j).totalDegree ≤ d := by
      intro i j
      change (C ((Fintype.equivFin _).symm i) ((Fintype.equivFin _).symm j)).totalDegree ≤ d
      unfold C lastCoefficientMatrix
      split
      · have h := finSucc_coefficient_totalDegree_le
          (flatten (A' ((Fintype.equivFin _).symm i).1 ((Fintype.equivFin _).symm j).1))
          d (M.matrixDegree _ _)
          (((Fintype.equivFin (Fin r × Fin (d+r*d))).symm i).2.val -
            ((Fintype.equivFin (Fin n × Fin (r*d))).symm j).2.val)
        simpa only [AlgEquiv.apply_symm_apply] using h
      · simp
    have hgenC := ih (Fintype.card (Fin r × Fin (d+r*d)))
      (Fintype.card (Fin n × Fin (r*d))) d (finiteMatrix C) hC
    have hstep := normalized_kernel_generation A' M.δ M.monic M.E M.mul_E M.E_kernel
      d (r*d) B hA' M.EDegree hgenC
    have hflat : A'.map flatten = A₀.map M.e := by
      apply Matrix.ext
      intro i j
      change flatten (finSuccEquiv K N (M.e (A₀ i j))) = M.e (A₀ i j)
      exact (finSuccEquiv K N).symm_apply_apply _
    rw [hflat] at hstep
    have hrows : Fintype.card (Fin r × Fin (d+r*d)) ≤ nextRows m d := by
      simp only [Fintype.card_prod, Fintype.card_fin]
      calc
        r * (d+r*d) ≤ m * (d+m*d) :=
          Nat.mul_le_mul hr (Nat.add_le_add_left (Nat.mul_le_mul_right d hr) d)
        _ = nextRows m d := by unfold nextRows; ring
    have hbudget : B+r*d ≤ recurrenceBound (N+1) m d :=
      Nat.add_le_add (recurrenceBound_mono N hrows le_rfl) (Nat.mul_le_mul_right d hr)
    apply kernel_generation_of_kernel_iff A A₀ hker
    apply kernel_generation_of_coordinates M.e M.preservesDegree A₀
    exact kernel_generation_mono _ hbudget hstep

/-- A closed uniform degree bound for the genuine polynomial kernel over an
infinite field. Its dependence on row count and input degree is explicit. -/
theorem kernel_generation_infinite (N m n d : ℕ)
    (A : Matrix (Fin m) (Fin n) (MvPolynomial (Fin N) K))
    (hA : ∀ i j, (A i j).totalDegree ≤ d) :
    LinearMap.ker A.mulVecLin =
      Submodule.span (MvPolynomial (Fin N) K) (degreeKernel A (hermannBound N m d)) :=
  kernel_generation_mono A (recurrenceBound_le N m d)
    (kernel_generation_recurrence N m n d A hA)

end
end Decoupling.HighDim.Hermann
