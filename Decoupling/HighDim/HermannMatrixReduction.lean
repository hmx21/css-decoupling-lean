import Decoupling.HighDim.HermannSyzygyMatrix

/-!
# All-coordinate Hermann reduction by an actual syzygy matrix

If A E = 0 and E acts on ker A as δ, genuine monic division of every
coordinate yields y = E q + z, with z again in ker A and strictly smaller
last-variable degree. For the actual E these identities are proved in
HermannSyzygyMatrix; they are not a new assumption on the final input.
-/

namespace Decoupling.HighDim.Hermann
open Polynomial Matrix
noncomputable section
variable {R : Type*} [CommRing R] {m n : ℕ}

def matrixRemainder (δ : R[X]) (E : Matrix (Fin n) (Fin n) R[X]) (y : Fin n → R[X]) :=
  y - E *ᵥ (fun j => y j /ₘ δ)

theorem scalar_matrixRemainder (δ : R[X]) (E : Matrix (Fin n) (Fin n) R[X])
    (y : Fin n → R[X]) (hEy : E *ᵥ y = δ • y) :
    δ • matrixRemainder δ E y = E *ᵥ (fun j => y j %ₘ δ) := by
  unfold matrixRemainder
  rw [smul_sub, ← Matrix.mulVec_smul, ← hEy, ← Matrix.mulVec_sub]
  congr 1
  funext j
  exact (Polynomial.modByMonic_eq_sub_mul_div (y j) δ).symm

theorem matrixRemainder_mem_ker (δ : R[X])
    (A : Matrix (Fin m) (Fin n) R[X]) (E : Matrix (Fin n) (Fin n) R[X])
    (hAE : A * E = 0) (y : Fin n → R[X]) (hy : A *ᵥ y = 0) :
    A *ᵥ matrixRemainder δ E y = 0 := by
  rw [matrixRemainder, Matrix.mulVec_sub, Matrix.mulVec_mulVec, hAE, Matrix.zero_mulVec, hy, sub_zero]

theorem matrixRemainder_decomposition (δ : R[X]) (E : Matrix (Fin n) (Fin n) R[X])
    (y : Fin n → R[X]) : y = E *ᵥ (fun j => y j /ₘ δ) + matrixRemainder δ E y := by
  unfold matrixRemainder
  abel

def smallLastKernel (A : Matrix (Fin m) (Fin n) R[X]) (M : ℕ) : Set (Fin n → R[X]) :=
  {y | A *ᵥ y = 0 ∧ ∀ j, (y j).degree < (M : WithBot ℕ)}

variable [IsDomain R]

/-- Every coordinate has the strict bound, including a unit minor δ=1. -/
theorem matrixRemainder_degree (δ : R[X]) (hδ : δ.Monic)
    (E : Matrix (Fin n) (Fin n) R[X]) (M : ℕ)
    (hE : ∀ i j, (E i j).natDegree ≤ M)
    (y : Fin n → R[X]) (hEy : E *ᵥ y = δ • y) (i : Fin n) :
    (matrixRemainder δ E y i).degree < (M : WithBot ℕ) := by
  have heq := scalar_matrixRemainder δ E y hEy
  by_cases hδ1 : δ = 1
  · have hz : matrixRemainder δ E y = 0 := by
      have hzero : (fun j => y j %ₘ δ) = (0 : Fin n → R[X]) := by
        funext j
        simp [hδ1]
      rw [hzero, Matrix.mulVec_zero, hδ1, one_smul] at heq
      simpa only [hδ1] using heq
    simp [hz]
  · apply normal_head_degree_lt δ hδ hδ1 (-E) M
      (fun i j => by simpa only [Matrix.neg_apply, Polynomial.natDegree_neg] using hE i j)
      (matrixRemainder δ E y, fun j => y j %ₘ δ)
      ?_ (fun j => Polynomial.natDegree_modByMonic_lt _ hδ hδ1) i
    funext j
    change δ * matrixRemainder δ E y j + ((-E) *ᵥ (fun j => y j %ₘ δ)) j = 0
    rw [Matrix.neg_mulVec]
    exact add_neg_eq_zero.mpr (congrFun heq j)

/-- The actual entire kernel is generated by the constructed columns of E
and the last-variable-bounded solution space. -/
theorem kernel_eq_span_columns_small (δ : R[X]) (hδ : δ.Monic)
    (A : Matrix (Fin m) (Fin n) R[X]) (E : Matrix (Fin n) (Fin n) R[X])
    (hAE : A * E = 0) (hEker : ∀ y, A *ᵥ y = 0 → E *ᵥ y = δ • y)
    (M : ℕ) (hE : ∀ i j, (E i j).natDegree ≤ M) :
    LinearMap.ker A.mulVecLin =
      Submodule.span R[X] (Set.range E.col ∪ smallLastKernel A M) := by
  apply le_antisymm
  · intro y hy
    rw [matrixRemainder_decomposition δ E y]
    apply Submodule.add_mem
    · have hmem : E *ᵥ (fun j => y j /ₘ δ) ∈ Submodule.span R[X] (Set.range E.col) := by
        rw [← Matrix.range_mulVecLin]
        exact ⟨_, rfl⟩
      exact Submodule.span_mono Set.subset_union_left hmem
    · apply Submodule.subset_span
      exact Or.inr ⟨matrixRemainder_mem_ker δ A E hAE y hy,
        matrixRemainder_degree δ hδ E M hE y (hEker y hy)⟩
  · apply Submodule.span_le.mpr
    rintro y (⟨j, rfl⟩ | hy)
    · funext i
      exact congrArg (fun B => B i j) hAE
    · exact hy.1

end
end Decoupling.HighDim.Hermann
