import Decoupling.HighDim.KoszulComplex
import Decoupling.HighDim.KoszulRegular
import Mathlib.LinearAlgebra.Finsupp.Pi

/-!
# The augmented end of the Koszul complex

Source: `drafts/main.tex:378–382`.
The actual degree-zero cell module is identified with the coefficient
ring. The image of the first differential is proved to be the ideal
generated by the weights. For Laurent coordinate differences this gives
exactness at the augmented degree-zero term, including dimension zero.
Positive-degree exactness is not assumed or asserted here.
-/

namespace Decoupling.HighDim.Koszul

noncomputable section

variable (A : Type*) [CommRing A] {D : ℕ}

def zeroCell (D : ℕ) : Cell D 0 := OrderEmbedding.ofIsEmpty

instance zeroCellSubsingleton (D : ℕ) : Subsingleton (Cell D 0) := by
  refine ⟨fun I J => ?_⟩
  apply DFunLike.ext
  intro a
  exact Fin.elim0 a

/-- The canonical degree-zero basis identification, `e_∅ ↦ 1`. -/
def zeroTermEquiv : Term A D 0 ≃ₗ[A] A :=
  Finsupp.uniqueLinearEquiv A A (zeroCell D)

@[simp] theorem zeroTermEquiv_single (I : Cell D 0) (a : A) :
    zeroTermEquiv A (Finsupp.single I a) = a := by
  simp [zeroTermEquiv, Subsingleton.elim I (zeroCell D)]

def singletonCell (i : Fin D) : Cell D 1 where
  toFun _ := i
  inj' _ _ _ := Subsingleton.elim _ _
  map_rel_iff' := by intro a b; simp [Subsingleton.elim a b]

@[simp] theorem singletonCell_apply (i : Fin D) (j : Fin 1) : singletonCell i j = i := rfl

def oneCellEquiv : Cell D 1 ≃ Fin D where
  toFun I := I 0
  invFun := singletonCell
  left_inv I := by
    apply DFunLike.ext
    intro j
    exact congrArg I (Subsingleton.elim 0 j)
  right_inv _ := rfl

variable (w : Fin D → A)

/-- The first differential after the actual identification `K₀ ≃ A`. -/
def firstBoundary : Term A D 1 →ₗ[A] A :=
  (zeroTermEquiv A).toLinearMap.comp (boundary A w 0).hom

@[simp] theorem firstBoundary_single (I : Cell D 1) (a : A) :
    firstBoundary A w (Finsupp.single I a) = a * w (I 0) := by
  simp [firstBoundary, boundary, weightedFace, Finsupp.smul_single, smul_eq_mul]

theorem firstBoundary_eq_linearCombination :
    firstBoundary A w = Finsupp.linearCombination A (fun I : Cell D 1 => w (I 0)) := by
  apply Finsupp.lhom_ext
  intro I a
  simp [smul_eq_mul]

/-- The image is exactly the generated ideal, proved from the concrete
differential and the basis, for arbitrary weights and dimension. -/
theorem range_firstBoundary :
    LinearMap.range (firstBoundary A w) = Ideal.span (Set.range w) := by
  rw [firstBoundary_eq_linearCombination, Finsupp.range_linearCombination]
  apply congrArg (Submodule.span A)
  ext a
  constructor
  · rintro ⟨I, rfl⟩
    exact ⟨I 0, rfl⟩
  · rintro ⟨i, rfl⟩
    exact ⟨singletonCell i, rfl⟩

/-- Exactness at degree zero in the Laurent augmented complex. -/
theorem laurent_exact_at_zero (K : Type*) [CommRing K] (D : ℕ)
    (v : Term (Laurent K D) D 0) :
    augmentation (zeroTermEquiv (Laurent K D) v) = 0 ↔
      ∃ u : Term (Laurent K D) D 1,
        boundary (Laurent K D) (difference K) 0 u = v := by
  rw [← RingHom.mem_ker, ker_augmentation_eq]
  change zeroTermEquiv (Laurent K D) v ∈ Ideal.span (Set.range (difference K)) ↔ _
  rw [← range_firstBoundary]
  constructor
  · rintro ⟨u, hu⟩
    exact ⟨u, (zeroTermEquiv (Laurent K D)).injective hu⟩
  · rintro ⟨u, rfl⟩
    exact ⟨u, rfl⟩

/-- The degree-zero augmentation is surjective, with constant lift. -/
theorem laurent_augmentation_surjective (K : Type*) [CommRing K] (D : ℕ) :
    Function.Surjective (fun v : Term (Laurent K D) D 0 =>
      augmentation (zeroTermEquiv (Laurent K D) v)) := by
  intro c
  refine ⟨(zeroTermEquiv (Laurent K D)).symm (constant c), ?_⟩
  simp

end

end Decoupling.HighDim.Koszul
