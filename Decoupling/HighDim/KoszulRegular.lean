import Decoupling.HighDim.Augmentation
import Mathlib.Algebra.MonoidAlgebra.NoZeroDivisors
import Mathlib.RingTheory.Regular.RegularSequence
import Mathlib.Data.List.OfFn

/-!
# Regularity of Laurent coordinate differences

Source: `drafts/main.tex:370–382`, the exact Koszul resolution assertion.
For every subset of coordinate directions we compute the actual kernel of
partial evaluation at `x_i = 1`. Every remaining `x_j - 1` is proved regular
on the quotient by those differences. This supplies the regularity input
for a later proof of Koszul exactness; no exactness statement is assumed.
-/

namespace Decoupling.HighDim.Koszul

noncomputable section

variable {K : Type*} [CommRing K] {D : ℕ}

/-- Set the selected translation coordinates to zero. -/
def eraseCoordinates (T : Finset (Fin D)) : Translation D →+ Translation D where
  toFun a i := if i ∈ T then 0 else a i
  map_zero' := by funext i; simp
  map_add' := by intro a b; funext i; by_cases h : i ∈ T <;> simp [h]

@[simp] theorem eraseCoordinates_basis (T : Finset (Fin D)) (i : Fin D) :
    eraseCoordinates T (translationBasis i) = if i ∈ T then 0 else translationBasis i := by
  classical
  funext j
  by_cases hi : i ∈ T
  · by_cases hij : i = j
    · subst j; simp [eraseCoordinates, translationBasis, hi]
    · simp [eraseCoordinates, translationBasis, hi, Ne.symm hij]
  · by_cases hij : i = j
    · subst j; simp [eraseCoordinates, translationBasis, hi]
    · simp [eraseCoordinates, translationBasis, hi, Ne.symm hij]

/-- The actual Laurent endomorphism setting the selected variables to one. -/
def partialEvaluation (K : Type*) [CommRing K] {D : ℕ} (T : Finset (Fin D)) :
    Laurent K D →+* Laurent K D :=
  AddMonoidAlgebra.mapDomainRingHom K (eraseCoordinates T)

@[simp] theorem partialEvaluation_monomial (T : Finset (Fin D)) (a : Translation D) :
    partialEvaluation K T (monomial K a) = monomial K (eraseCoordinates T a) := by
  simp [partialEvaluation, monomial]

@[simp] theorem partialEvaluation_constant (T : Finset (Fin D)) (c : K) :
    partialEvaluation K T (constant c) = constant c := by
  simp [partialEvaluation, constant]

@[simp] theorem partialEvaluation_difference (T : Finset (Fin D)) (i : Fin D) :
    partialEvaluation K T (difference K i) = if i ∈ T then 0 else difference K i := by
  classical
  simp only [difference, coordinate, map_sub, partialEvaluation_monomial,
    eraseCoordinates_basis, map_one]
  split_ifs <;> simp

/-- The ideal generated by precisely the selected coordinate differences. -/
def coordinateIdeal (K : Type*) [CommRing K] {D : ℕ} (T : Finset (Fin D)) :
    Ideal (Laurent K D) := Ideal.span ((difference K) '' (T : Set (Fin D)))

theorem difference_mem_coordinateIdeal (T : Finset (Fin D)) (i : Fin D) (hi : i ∈ T) :
    difference K i ∈ coordinateIdeal K T :=
  Ideal.subset_span ⟨i, hi, rfl⟩

theorem exponent_sub_erase_mem (T : Finset (Fin D)) (a : Translation D) :
    a - eraseCoordinates T a ∈ monomialCongruenceExponents (coordinateIdeal K T) := by
  have ha : a - eraseCoordinates T a = ∑ i ∈ T, a i • translationBasis i := by
    funext j
    by_cases hj : j ∈ T <;>
      simp [eraseCoordinates, Finset.sum_apply, translationBasis, Pi.single_apply, hj]
  rw [ha]
  apply AddSubgroup.sum_mem
  intro i hi
  apply AddSubgroup.zsmul_mem
  exact difference_mem_coordinateIdeal T i hi

theorem monomial_sub_partialEvaluation_mem (T : Finset (Fin D)) (a : Translation D) :
    monomial K a - partialEvaluation K T (monomial K a) ∈ coordinateIdeal K T := by
  rw [partialEvaluation_monomial]
  have hm : monomial K (eraseCoordinates T a) *
      monomial K (a - eraseCoordinates T a) = monomial K a := by
    rw [monomial_mul]
    congr 1
    abel
  simpa only [mul_sub, hm, mul_one] using
    (coordinateIdeal K T).mul_mem_left (monomial K (eraseCoordinates T a))
      (exponent_sub_erase_mem (K := K) T a)

/-- Every Laurent polynomial differs from its partial evaluation by an
element of the generated ideal, including for negative exponents. -/
theorem sub_partialEvaluation_mem (T : Finset (Fin D)) (f : Laurent K D) :
    f - partialEvaluation K T f ∈ coordinateIdeal K T := by
  refine AddMonoidAlgebra.induction_on
    (motive := fun g : Laurent K D => g - partialEvaluation K T g ∈ coordinateIdeal K T)
    f ?_ ?_ ?_
  · intro a
    exact monomial_sub_partialEvaluation_mem T a
  · intro f g hf hg
    rw [map_add]
    convert (coordinateIdeal K T).add_mem hf hg using 1
    ring
  · intro c f hf
    have hc : c • f = constant c * f := by
      change c • f = AddMonoidAlgebra.single 0 c * f
      ext a
      simp
    rw [hc, map_mul, partialEvaluation_constant, ← mul_sub]
    exact (coordinateIdeal K T).mul_mem_left (constant c) hf

/-- Partial evaluation has exactly the ideal generated by the erased
coordinate differences as its kernel. -/
theorem ker_partialEvaluation (T : Finset (Fin D)) :
    RingHom.ker (partialEvaluation K T) = coordinateIdeal K T := by
  apply le_antisymm
  · intro f hf
    have hz := RingHom.mem_ker.mp hf
    simpa only [hz, sub_zero] using sub_partialEvaluation_mem T f
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, hi, rfl⟩
    have hi' : i ∈ T := hi
    simp [RingHom.mem_ker, hi']

theorem difference_ne_zero [Nontrivial K] (i : Fin D) : difference K i ≠ 0 := by
  have hi : translationBasis i ≠ 0 := by
    intro h
    have := congrFun h i
    simp [translationBasis] at this
  intro h
  have hc := congrArg (fun f : Laurent K D => f.coeff (translationBasis i)) h
  simp [difference, coordinate, monomial, AddMonoidAlgebra.one_def, hi] at hc

/-- The directions preceding the `n`-th direction. -/
def initialDirections (D n : ℕ) : Finset (Fin D) :=
  Finset.univ.filter (fun i => i.val < n)

/-- The coordinate-difference list in the paper's increasing order. -/
def coordinateSequence (K : Type*) [CommRing K] (D : ℕ) : List (Laurent K D) :=
  List.ofFn (difference K)

theorem ofList_take_coordinateSequence (n : ℕ) :
    Ideal.ofList ((coordinateSequence K D).take n) =
      coordinateIdeal K (initialDirections D n) := by
  unfold Ideal.ofList coordinateIdeal
  apply congrArg Ideal.span
  ext f
  simp only [Set.mem_ofPred_eq, coordinateSequence, List.mem_take_iff_getElem,
    List.length_ofFn, List.getElem_ofFn, Set.mem_image, Finset.mem_coe,
    initialDirections, Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨j, hj, rfl⟩
    exact ⟨⟨j, (Nat.lt_min.mp hj).2⟩, (Nat.lt_min.mp hj).1, rfl⟩
  · rintro ⟨i, hi, rfl⟩
    exact ⟨i.val, Nat.lt_min.mpr ⟨hi, i.is_lt⟩, rfl⟩

theorem ofList_coordinateSequence :
    Ideal.ofList (coordinateSequence K D) = augmentationIdeal K D := by
  unfold Ideal.ofList coordinateSequence augmentationIdeal
  apply congrArg Ideal.span
  ext f
  simp only [Set.mem_ofPred_eq, List.mem_ofFn', Set.mem_range]

section Domain

variable [IsDomain K]

/-- A coordinate difference outside the erased set is a non-zero-divisor
on the actual quotient. The proof evaluates into a domain and cancels the
nonzero surviving coordinate difference. -/
theorem difference_mul_mem_coordinateIdeal_iff (T : Finset (Fin D))
    (i : Fin D) (hi : i ∉ T) (f : Laurent K D) :
    difference K i * f ∈ coordinateIdeal K T ↔ f ∈ coordinateIdeal K T := by
  rw [← ker_partialEvaluation, RingHom.mem_ker, RingHom.mem_ker, map_mul,
    partialEvaluation_difference, ite_eq_right hi]
  exact mul_eq_zero.trans (or_iff_right (difference_ne_zero i))

/-- Native regularity on each coordinate quotient, not a replacement
predicate for regularity or for Koszul exactness. -/
theorem difference_regular_quotient (T : Finset (Fin D)) (i : Fin D) (hi : i ∉ T) :
    IsSMulRegular ((Laurent K D) ⧸ coordinateIdeal K T) (difference K i) := by
  apply (isSMulRegular_quotient_iff_mem_of_smul_mem (coordinateIdeal K T)
    (difference K i)).mpr
  intro f hf
  exact (difference_mul_mem_coordinateIdeal_iff T i hi f).mp hf

/-- Native weak regularity for all the coordinate differences, proved from
the explicit partial-evaluation quotients. -/
theorem coordinateSequence_weaklyRegular :
    RingTheory.Sequence.IsWeaklyRegular (Laurent K D) (coordinateSequence K D) := by
  constructor
  intro n hn
  have hn' : n < D := by simpa [coordinateSequence] using hn
  rw [Ideal.smul_eq_mul, Ideal.mul_top, ofList_take_coordinateSequence]
  simpa only [coordinateSequence, List.getElem_ofFn] using
    difference_regular_quotient (K := K) (initialDirections D n) ⟨n, hn'⟩ (by
      simp [initialDirections])

/-- The ordered coordinate differences form a native regular sequence.
Properness comes from the actual nonzero augmentation quotient. -/
theorem coordinateSequence_regular :
    RingTheory.Sequence.IsRegular (Laurent K D) (coordinateSequence K D) where
  toIsWeaklyRegular := coordinateSequence_weaklyRegular
  top_ne_smul := by
    rw [Ideal.smul_eq_mul, Ideal.mul_top, ofList_coordinateSequence]
    intro h
    have h1 : (1 : Laurent K D) ∈ augmentationIdeal K D := h ▸ Submodule.mem_top
    have hz : augmentation (1 : Laurent K D) = 0 :=
      RingHom.mem_ker.mp (augmentationIdeal_le_ker h1)
    exact one_ne_zero (by simpa only [map_one] using hz)

end Domain

end

end Decoupling.HighDim.Koszul
