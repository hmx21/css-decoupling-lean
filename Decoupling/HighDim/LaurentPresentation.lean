import Decoupling.HighDim.Laurent
import Mathlib.Algebra.MvPolynomial.CommRing
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# HD012 the actual 2D-variable polynomial presentation of the Laurent ring

Positive and negative variables are independent polynomial variables.
The evaluation map imposes their actual inverse relations; its kernel
is proved to be generated by X_i Y_i - 1.
-/
namespace Decoupling.HighDim.LaurentPresentation
noncomputable section
set_option backward.isDefEq.respectTransparency false

variable (K : Type*) [CommRing K] (D : ℕ)
abbrev Poly := MvPolynomial (Fin D ⊕ Fin D) K

def exponentMap : ((Fin D ⊕ Fin D) →₀ ℕ) →+ Translation D where
  toFun a i := (a (Sum.inl i) : ℤ) - (a (Sum.inr i) : ℤ)
  map_zero' := by funext i; simp
  map_add' a b := by funext i; simp; ring

def evaluate : Poly K D →+* Laurent K D := AddMonoidAlgebra.mapDomainRingHom K (exponentMap D)

theorem evaluate_monomial (a : (Fin D ⊕ Fin D) →₀ ℕ) (c : K) :
    evaluate K D (MvPolynomial.monomial a c) = AddMonoidAlgebra.single (exponentMap D a) c := by
  simp [evaluate, MvPolynomial.monomial]

@[simp] theorem evaluate_C (c : K) : evaluate K D (MvPolynomial.C c) = constant c := by
  change evaluate K D (MvPolynomial.monomial 0 c) = AddMonoidAlgebra.single 0 c
  rw [evaluate_monomial, map_zero]

theorem exponentMap_positive (i : Fin D) :
    exponentMap D (Finsupp.single (Sum.inl i) 1) = translationBasis i := by
  classical
  funext j
  simp [exponentMap, translationBasis, Pi.single_apply, Finsupp.single_apply, eq_comm]

theorem exponentMap_negative (i : Fin D) :
    exponentMap D (Finsupp.single (Sum.inr i) 1) = -translationBasis i := by
  classical
  funext j
  simp [exponentMap, translationBasis, Pi.single_apply, Finsupp.single_apply, eq_comm]

@[simp] theorem evaluate_X_positive (i : Fin D) :
    evaluate K D (MvPolynomial.X (Sum.inl i)) = coordinate K i := by
  rw [MvPolynomial.X, evaluate_monomial, exponentMap_positive]
  rfl

@[simp] theorem evaluate_X_negative (i : Fin D) :
    evaluate K D (MvPolynomial.X (Sum.inr i)) = monomial K (-translationBasis i) := by
  rw [MvPolynomial.X, evaluate_monomial, exponentMap_negative]
  rfl

def relation (i : Fin D) : Poly K D := MvPolynomial.X (Sum.inl i) * MvPolynomial.X (Sum.inr i) - 1
def relationIdeal : Ideal (Poly K D) := Ideal.span (Set.range (relation K D))

theorem relation_mem (i : Fin D) : relation K D i ∈ relationIdeal K D :=
  Ideal.subset_span (Set.mem_range_self i)

@[simp] theorem evaluate_relation (i : Fin D) : evaluate K D (relation K D i) = 0 := by
  simp [relation, coordinate]

theorem relationIdeal_le_ker : relationIdeal K D ≤ RingHom.ker (evaluate K D) := by
  apply Ideal.span_le.mpr
  rintro _ ⟨i, rfl⟩
  exact evaluate_relation K D i

abbrev QuotientRing := Poly K D ⧸ relationIdeal K D

def variableUnit (i : Fin D) : Units (QuotientRing K D) where
  val := Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl i))
  inv := Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i))
  val_inv := by
    apply sub_eq_zero.mp
    rw [← map_mul, ← map_one (Ideal.Quotient.mk (relationIdeal K D)), ← map_sub]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (relation_mem K D i)
  inv_val := by
    rw [mul_comm]
    apply sub_eq_zero.mp
    rw [← map_mul, ← map_one (Ideal.Quotient.mk (relationIdeal K D)), ← map_sub]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (relation_mem K D i)

def translationUnits : Multiplicative (Translation D) →* Units (QuotientRing K D) where
  toFun a := ∏ i, variableUnit K D i ^ a.toAdd i
  map_one' := by simp
  map_mul' a b := by simp [zpow_add, Finset.prod_mul_distrib]

def fromLaurent : Laurent K D →+* QuotientRing K D :=
  AddMonoidAlgebra.liftNCRingHom
    ((Ideal.Quotient.mk (relationIdeal K D)).comp MvPolynomial.C)
    ((Units.coeHom (QuotientRing K D)).comp (translationUnits K D)) (fun _ _ => Commute.all _ _)

@[simp] theorem fromLaurent_constant (a : K) :
    fromLaurent K D (constant a) = Ideal.Quotient.mk _ (MvPolynomial.C a) := by
  simp [fromLaurent, constant]

@[simp] theorem fromLaurent_positive (i : Fin D) :
    fromLaurent K D (coordinate K i) = Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl i)) := by
  classical
  simp [coordinate, monomial, fromLaurent, translationUnits, translationBasis,
    Pi.single_apply, variableUnit]

@[simp] theorem fromLaurent_negative (i : Fin D) :
    fromLaurent K D (monomial K (-translationBasis i)) =
      Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) := by
  classical
  simp [monomial, fromLaurent, translationUnits, translationBasis, Pi.single_apply, variableUnit, apply_ite]

theorem fromLaurent_evaluate : (fromLaurent K D).comp (evaluate K D) =
    Ideal.Quotient.mk (relationIdeal K D) := by
  apply MvPolynomial.ringHom_ext
  · intro a
    change fromLaurent K D (evaluate K D (MvPolynomial.C a)) =
      Ideal.Quotient.mk _ (MvPolynomial.C a)
    rw [evaluate_C, fromLaurent_constant]
  · intro i
    cases i <;> simp

/-- The polynomial inverse relations are the full kernel, not just relations
which happen to vanish after evaluation. -/
theorem kernel_evaluate : RingHom.ker (evaluate K D) = relationIdeal K D := by
  apply le_antisymm _ (relationIdeal_le_ker K D)
  intro f hf
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  have h := congrArg (fun g : Poly K D →+* QuotientRing K D => g f) (fromLaurent_evaluate K D)
  rw [RingHom.comp_apply, RingHom.mem_ker.mp hf, map_zero] at h
  exact h.symm

end
end Decoupling.HighDim.LaurentPresentation
