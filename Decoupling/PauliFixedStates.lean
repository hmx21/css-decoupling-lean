import Decoupling.PauliUnitary
import Mathlib.LinearAlgebra.FiniteDimensional.Basic

/-!
# The common fixed spaces of identity-X and identity-Z checks

The simultaneous +1 eigenspaces are exactly the complex lines generated by
the normalized all-plus and all-zero states. Empty qubit sets are included.
-/

namespace Decoupling.PauliFixedStates

open Matrix PauliUnitary

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Invariance under all X supports is exactly constant computational amplitude. -/
theorem all_X_fixed_iff (ψ : State ι) :
    (∀ a, X a *ᵥ ψ = ψ) ↔ ∀ s, ψ s = ψ 0 := by
  constructor
  · intro h s
    simpa only [X_apply, zero_add] using congrFun (h s) 0
  · intro h a
    funext s
    rw [X_apply, h (s + a), h s]

/-- Invariance under all Z supports is exactly support at the zero configuration. -/
theorem all_Z_fixed_iff (ψ : State ι) :
    (∀ b, Z b *ᵥ ψ = ψ) ↔ ∀ s, s ≠ 0 → ψ s = 0 := by
  constructor
  · intro h s hs
    obtain ⟨i, hi⟩ : ∃ i, s i ≠ 0 := by
      by_contra! hh
      exact hs (funext hh)
    have hsign : sign (s i) = -1 := by simp [sign, hi]
    have hz := congrFun (h (Pi.single i 1)) s
    simp only [Z_apply, single_dotProduct, one_mul, hsign, neg_one_mul] at hz
    have hh : (2 : ℂ) * ψ s = 0 := by linear_combination -hz
    exact (mul_eq_zero.mp hh).resolve_left (by norm_num)
  · intro h b
    funext s
    by_cases hs : s = 0
    · subst s
      simp [Z_apply]
    · simp [Z_apply, h s hs]

/-- Actual simultaneous +1 eigenspace of the pure X checks. -/
def fixedX : Submodule ℂ (State ι) where
  carrier := {ψ | ∀ a, X a *ᵥ ψ = ψ}
  zero_mem' := by intro a; simp
  add_mem' := by intro ψ χ hψ hχ a; rw [Matrix.mulVec_add, hψ a, hχ a]
  smul_mem' := by intro c ψ hψ a; rw [Matrix.mulVec_smul, hψ a]

/-- Actual simultaneous +1 eigenspace of the pure Z checks. -/
def fixedZ : Submodule ℂ (State ι) where
  carrier := {ψ | ∀ b, Z b *ᵥ ψ = ψ}
  zero_mem' := by intro b; simp
  add_mem' := by intro ψ χ hψ hχ b; rw [Matrix.mulVec_add, hψ b, hχ b]
  smul_mem' := by intro c ψ hψ b; rw [Matrix.mulVec_smul, hψ b]

theorem plus_amplitude_ne_zero : plusState (ι := ι) 0 ≠ 0 := by
  have hc : (0 : ℝ) < Fintype.card (Bits ι) := by exact_mod_cast Fintype.card_pos
  change ((Real.sqrt (Fintype.card (Bits ι) : ℝ) : ℂ))⁻¹ ≠ 0
  apply inv_ne_zero
  exact_mod_cast ne_of_gt (Real.sqrt_pos.mpr hc)

theorem plusState_ne_zero : (plusState : State ι) ≠ 0 := by
  intro h
  exact plus_amplitude_ne_zero (congrFun h 0)

omit [DecidableEq ι] in
theorem zeroState_ne_zero : (zeroState : State ι) ≠ 0 := by
  intro h
  have hh := congrFun h 0
  simp [zeroState, ket] at hh

/-- Identity-X checks fix precisely the all-plus line, not merely one vector on it. -/
theorem fixedX_eq_span : (fixedX : Submodule ℂ (State ι)) =
    Submodule.span ℂ {plusState} := by
  ext ψ
  change (∀ a, X a *ᵥ ψ = ψ) ↔ ψ ∈ Submodule.span ℂ {plusState}
  rw [all_X_fixed_iff, Submodule.mem_span_singleton]
  constructor
  · intro h
    refine ⟨ψ 0 / plusState (ι := ι) 0, ?_⟩
    funext s
    change (ψ 0 / plusState (ι := ι) 0) * plusState s = ψ s
    change (ψ 0 / plusState (ι := ι) 0) * plusState (ι := ι) 0 = ψ s
    rw [div_mul_cancel₀ _ plus_amplitude_ne_zero, h s]
  · rintro ⟨c, rfl⟩ s
    rfl

/-- Identity-Z checks fix precisely the all-zero computational line. -/
theorem fixedZ_eq_span : (fixedZ : Submodule ℂ (State ι)) =
    Submodule.span ℂ {zeroState} := by
  ext ψ
  change (∀ b, Z b *ᵥ ψ = ψ) ↔ ψ ∈ Submodule.span ℂ {zeroState}
  rw [all_Z_fixed_iff, Submodule.mem_span_singleton]
  constructor
  · intro h
    refine ⟨ψ 0, ?_⟩
    funext s
    by_cases hs : s = 0
    · subst s
      simp [zeroState, ket]
    · simp [zeroState, ket, hs, h s hs]
  · rintro ⟨c, rfl⟩ s hs
    simp [zeroState, ket, hs]

theorem fixedX_finrank : Module.finrank ℂ (fixedX (ι := ι)) = 1 := by
  rw [fixedX_eq_span]
  exact finrank_span_singleton plusState_ne_zero

theorem fixedZ_finrank : Module.finrank ℂ (fixedZ (ι := ι)) = 1 := by
  rw [fixedZ_eq_span]
  exact finrank_span_singleton zeroState_ne_zero

end
end Decoupling.PauliFixedStates
