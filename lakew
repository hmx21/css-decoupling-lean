#!/bin/sh
# Prefer the project-local toolchain; otherwise use the user's standard Lake.
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$project_dir"
export MATHLIB_CACHE_DIR="$project_dir/.cache/mathlib"
toolchain_bin="$project_dir/.toolchain/lean-4.34.0-darwin_aarch64/bin"
if [ -x "$toolchain_bin/lake" ]; then
  export PATH="$toolchain_bin:$PATH"
  exec "$toolchain_bin/lake" "$@"
fi
exec lake "$@"
